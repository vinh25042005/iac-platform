# Sao chép thành terraform.tfvars cho từng env (new-project.sh tự sinh)
project = "techshop"
env     = "stg"

region = "ap-southeast-1"

# ── Cụm kubeadm ──
key_name      = "techshop-key"      # ← AWS key pair đã tạo
instance_type = "t3.small"
node_count    = 3                    # ← điền số node bạn muốn (1 master + N-1 worker)
